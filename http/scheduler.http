# Vehicle Service Scheduler - client stub (Visual Studio and VS Code REST Client).
#
# Start the stack with: docker compose up --build
# Bookings persist in PostgreSQL. Run this file from top to bottom on a fresh database;
# reset it with: docker compose down -v
# The ids below are the fixed sample-data ids (see "Sample data" in the README).

@baseUrl = http://localhost:8080

@london = d0000000-0000-4000-8000-000000000001
@saigon = d0000000-0000-4000-8000-000000000002

@oilChange = 5e000000-0000-4000-8000-000000000001
@brakeInspection = 5e000000-0000-4000-8000-000000000002
@wheelAlignment = 5e000000-0000-4000-8000-000000000003

@janeSmith = c0000000-0000-4000-8000-000000000001
@nguyenVanAn = c0000000-0000-4000-8000-000000000002

@golf = ca000000-0000-4000-8000-000000000001
@tesla = ca000000-0000-4000-8000-000000000002
@vinfast = ca000000-0000-4000-8000-000000000003

### 1. Book an oil change (60 min) - expect 201 Created with a Location header
# @name book
POST {{baseUrl}}/appointments
Content-Type: application/json

{
  "customerId": "{{janeSmith}}",
  "vehicleId": "{{golf}}",
  "dealershipId": "{{london}}",
  "serviceTypeId": "{{oilChange}}",
  "startAt": "2030-01-07T09:00:00Z"
}

### 2. Get the appointment just booked - expect 200 OK
GET {{baseUrl}}{{book.response.headers.Location}}

### 3. Book with a non-UTC offset - expect 201 Created, startAt returned in UTC (2030-01-08T09:00:00Z)
POST {{baseUrl}}/appointments
Content-Type: application/json

{
  "customerId": "{{janeSmith}}",
  "vehicleId": "{{golf}}",
  "dealershipId": "{{london}}",
  "serviceTypeId": "{{oilChange}}",
  "startAt": "2030-01-08T10:00:00+01:00"
}

### 4. Book a brake inspection (90 min) - expect 201 Created, endAt is 90 minutes after startAt
POST {{baseUrl}}/appointments
Content-Type: application/json

{
  "customerId": "{{janeSmith}}",
  "vehicleId": "{{golf}}",
  "dealershipId": "{{london}}",
  "serviceTypeId": "{{brakeInspection}}",
  "startAt": "2030-01-09T09:00:00Z"
}

### 5. Same vehicle overlaps request 1 - expect 409 Conflict, problem type vehicle-already-booked
POST {{baseUrl}}/appointments
Content-Type: application/json

{
  "customerId": "{{janeSmith}}",
  "vehicleId": "{{golf}}",
  "dealershipId": "{{london}}",
  "serviceTypeId": "{{oilChange}}",
  "startAt": "2030-01-07T09:30:00Z"
}

### 6. Another vehicle in the same slot takes the second general bay - expect 201 Created
POST {{baseUrl}}/appointments
Content-Type: application/json

{
  "customerId": "{{janeSmith}}",
  "vehicleId": "{{tesla}}",
  "dealershipId": "{{london}}",
  "serviceTypeId": "{{oilChange}}",
  "startAt": "2030-01-07T09:00:00Z"
}

### 7. Both general bays are taken - expect 409 Conflict, problem type no-capacity, shortage bays
POST {{baseUrl}}/appointments
Content-Type: application/json

{
  "customerId": "{{nguyenVanAn}}",
  "vehicleId": "{{vinfast}}",
  "dealershipId": "{{london}}",
  "serviceTypeId": "{{oilChange}}",
  "startAt": "2030-01-07T09:00:00Z"
}

### 8. Saigon has no alignment bay - expect 422 Unprocessable Entity, problem type service-not-offered
POST {{baseUrl}}/appointments
Content-Type: application/json

{
  "customerId": "{{nguyenVanAn}}",
  "vehicleId": "{{vinfast}}",
  "dealershipId": "{{saigon}}",
  "serviceTypeId": "{{wheelAlignment}}",
  "startAt": "2030-01-09T03:00:00Z"
}

### 9. Jane books Nguyen Van An's vehicle - expect 422 Unprocessable Entity, problem type vehicle-not-owned
POST {{baseUrl}}/appointments
Content-Type: application/json

{
  "customerId": "{{janeSmith}}",
  "vehicleId": "{{vinfast}}",
  "dealershipId": "{{london}}",
  "serviceTypeId": "{{oilChange}}",
  "startAt": "2030-01-10T09:00:00Z"
}

### 10a. Start in the past - expect 422 Unprocessable Entity, problem type invalid-start-time
POST {{baseUrl}}/appointments
Content-Type: application/json

{
  "customerId": "{{janeSmith}}",
  "vehicleId": "{{golf}}",
  "dealershipId": "{{london}}",
  "serviceTypeId": "{{oilChange}}",
  "startAt": "2020-01-07T09:00:00Z"
}

### 10b. Start off the 15-minute grid (09:10 local) - expect 422 Unprocessable Entity, problem type invalid-start-time
POST {{baseUrl}}/appointments
Content-Type: application/json

{
  "customerId": "{{janeSmith}}",
  "vehicleId": "{{golf}}",
  "dealershipId": "{{london}}",
  "serviceTypeId": "{{oilChange}}",
  "startAt": "2030-01-11T09:10:00Z"
}

### 11a. Sunday, the dealership is closed - expect 422 Unprocessable Entity, problem type outside-opening-hours
POST {{baseUrl}}/appointments
Content-Type: application/json

{
  "customerId": "{{janeSmith}}",
  "vehicleId": "{{golf}}",
  "dealershipId": "{{london}}",
  "serviceTypeId": "{{oilChange}}",
  "startAt": "2030-01-06T10:00:00Z"
}

### 11b. 06:45 UTC is 07:45 in London (BST), before opening at 08:00 - expect 422 Unprocessable Entity, problem type outside-opening-hours
POST {{baseUrl}}/appointments
Content-Type: application/json

{
  "customerId": "{{janeSmith}}",
  "vehicleId": "{{golf}}",
  "dealershipId": "{{london}}",
  "serviceTypeId": "{{oilChange}}",
  "startAt": "2030-07-01T06:45:00Z"
}

### 12a. Unknown dealership - expect 404 Not Found, problem type not-found
POST {{baseUrl}}/appointments
Content-Type: application/json

{
  "customerId": "{{janeSmith}}",
  "vehicleId": "{{golf}}",
  "dealershipId": "00000000-0000-4000-8000-00000000dead",
  "serviceTypeId": "{{oilChange}}",
  "startAt": "2030-01-11T09:00:00Z"
}

### 12b. Unknown appointment - expect 404 Not Found, problem type not-found
GET {{baseUrl}}/appointments/7c9e6679-7425-40de-944b-e07fc1f90ae7

### 13a. Empty body - expect 400 Bad Request, problem type validation listing every missing field
POST {{baseUrl}}/appointments
Content-Type: application/json

{}

### 13b. startAt without a UTC offset - expect 400 Bad Request, problem type validation
POST {{baseUrl}}/appointments
Content-Type: application/json

{
  "customerId": "{{janeSmith}}",
  "vehicleId": "{{golf}}",
  "dealershipId": "{{london}}",
  "serviceTypeId": "{{oilChange}}",
  "startAt": "2030-01-07T09:00:00"
}

### Availability, rescheduling and cancellation (requests 14-26)
# These use dates that requests 1-13 leave free, so they are deterministic on a fresh database.
# The change-window-closed problem (changes within the 2-hour cut-off, Scheduling:ChangeCutoff)
# cannot be shown here, because these fixed 2030 dates are never within 2 hours of "now".

### 14. Free slots for an oil change on a Monday - expect 200 OK, 37 slots (08:00 to 17:00 every 15 minutes)
GET {{baseUrl}}/dealerships/{{london}}/availability?serviceTypeId={{oilChange}}&date=2030-01-14

### 15. Sunday, the dealership is closed - expect 200 OK, empty slots
GET {{baseUrl}}/dealerships/{{london}}/availability?serviceTypeId={{oilChange}}&date=2030-01-13

### 16. Saigon cannot perform wheel alignment - expect 422 Unprocessable Entity, problem type service-not-offered
GET {{baseUrl}}/dealerships/{{saigon}}/availability?serviceTypeId={{wheelAlignment}}&date=2030-01-14

### 17. Date in the wrong format - expect 400 Bad Request, problem type validation
GET {{baseUrl}}/dealerships/{{london}}/availability?serviceTypeId={{oilChange}}&date=14/01/2030

### 18. Book an appointment to change later - expect 201 Created
# @name toMove
POST {{baseUrl}}/appointments
Content-Type: application/json

{
  "customerId": "{{janeSmith}}",
  "vehicleId": "{{golf}}",
  "dealershipId": "{{london}}",
  "serviceTypeId": "{{oilChange}}",
  "startAt": "2030-01-15T09:00:00Z"
}

### 19. Alternative start times for it - expect 200 OK, 09:30 is listed (its own slot counts as free)
GET {{baseUrl}}/appointments/{{toMove.response.body.$.id}}/alternatives?date=2030-01-15

### 20. Reschedule to 09:30 - expect 200 OK, same id, startAt 2030-01-15T09:30:00Z
POST {{baseUrl}}/appointments/{{toMove.response.body.$.id}}/reschedule
Content-Type: application/json

{
  "startAt": "2030-01-15T09:30:00Z"
}

### 21. Reschedule to 07:00, before opening - expect 422 Unprocessable Entity, problem type outside-opening-hours
POST {{baseUrl}}/appointments/{{toMove.response.body.$.id}}/reschedule
Content-Type: application/json

{
  "startAt": "2030-01-15T07:00:00Z"
}

### 22. Cancel it - expect 200 OK, status Cancelled with cancelledAt set
POST {{baseUrl}}/appointments/{{toMove.response.body.$.id}}/cancel

### 23. Cancel it again - expect 200 OK, same state (cancelling twice is safe)
POST {{baseUrl}}/appointments/{{toMove.response.body.$.id}}/cancel

### 24. Reschedule the cancelled appointment - expect 422 Unprocessable Entity, problem type appointment-cancelled
POST {{baseUrl}}/appointments/{{toMove.response.body.$.id}}/reschedule
Content-Type: application/json

{
  "startAt": "2030-01-15T10:00:00Z"
}

### 25. Alternatives for the cancelled appointment - expect 422 Unprocessable Entity, problem type appointment-cancelled
GET {{baseUrl}}/appointments/{{toMove.response.body.$.id}}/alternatives?date=2030-01-15

### 26. Cancel an unknown appointment - expect 404 Not Found, problem type not-found
POST {{baseUrl}}/appointments/7c9e6679-7425-40de-944b-e07fc1f90ae7/cancel

### Idempotent booking (requests 27-30)
# Uses Monday 2030-01-21, which requests 1-26 leave free. Keep the key 3f1b2c9e-... for requests 27-29.

### 27. Book with an Idempotency-Key - expect 201 Created with a Location header
# @name keyed
POST {{baseUrl}}/appointments
Content-Type: application/json
Idempotency-Key: 3f1b2c9e-7a54-4d1e-9c2b-5b8f0e6a1d27

{
  "customerId": "{{janeSmith}}",
  "vehicleId": "{{golf}}",
  "dealershipId": "{{london}}",
  "serviceTypeId": "{{oilChange}}",
  "startAt": "2030-01-21T09:00:00Z"
}

### 28. Retry the identical request - expect 201 Created, same id and Location as request 27 (a replay, no second appointment)
POST {{baseUrl}}/appointments
Content-Type: application/json
Idempotency-Key: 3f1b2c9e-7a54-4d1e-9c2b-5b8f0e6a1d27

{
  "customerId": "{{janeSmith}}",
  "vehicleId": "{{golf}}",
  "dealershipId": "{{london}}",
  "serviceTypeId": "{{oilChange}}",
  "startAt": "2030-01-21T09:00:00Z"
}

### 29. Same key with a different start (10:00) - expect 422 Unprocessable Entity, problem type idempotency-key-reused
POST {{baseUrl}}/appointments
Content-Type: application/json
Idempotency-Key: 3f1b2c9e-7a54-4d1e-9c2b-5b8f0e6a1d27

{
  "customerId": "{{janeSmith}}",
  "vehicleId": "{{golf}}",
  "dealershipId": "{{london}}",
  "serviceTypeId": "{{oilChange}}",
  "startAt": "2030-01-21T10:00:00Z"
}

### 30. Key longer than 100 characters (101) - expect 400 Bad Request, problem type validation
POST {{baseUrl}}/appointments
Content-Type: application/json
Idempotency-Key: kkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkk

{
  "customerId": "{{janeSmith}}",
  "vehicleId": "{{golf}}",
  "dealershipId": "{{london}}",
  "serviceTypeId": "{{oilChange}}",
  "startAt": "2030-01-21T11:00:00Z"
}
